# ── Insight Esports web ─────────────────────────────────────────────────────
# Copy to .env.local for local dev; set the same keys in Vercel/Railway.

# Backend REST base (same as the iOS app's API_BASE_URL). Server-side only.
API_BASE_URL=https://esports-app-production.up.railway.app/api

# The backend's x-api-key (APP_API_KEY in backend/.env and Config.xcconfig).
# Server-side only — it is never sent to the browser.
APP_API_KEY=replace-me

# Only accounts whose email ends with @<this domain> may use the web app.
ALLOWED_EMAIL_DOMAIN=insightesportsapp.com

# Socket.IO connects straight from the browser (JWT auth, no api key).
# Host only, no /api suffix.
NEXT_PUBLIC_SOCKET_URL=https://esports-app-production.up.railway.app

# Set to "true" to mark cookies Secure (always true in production builds).
# COOKIE_SECURE=true

# Avatar upload (EditProfile): the browser sends the image to /api/avatar, which
# uploads it to Supabase Storage (bucket "avatars") with the user's token and
# registers the URL via POST /users/me/avatar — same flow as the iOS app.
# Same values as SUPABASE_URL / SUPABASE_ANON_KEY in Config.xcconfig.
# SUPABASE_URL=https://<project>.supabase.co
# SUPABASE_ANON_KEY=
