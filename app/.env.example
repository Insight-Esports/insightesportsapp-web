# ── Insight Esports web ─────────────────────────────────────────────────────
# Copy to .env.local for local dev; set the same keys in Railway's Variables.

# Backend REST base (same as the iOS app's API_BASE_URL). Server-side only.
API_BASE_URL=https://esports-app-production.up.railway.app/api

# The backend's x-api-key (APP_API_KEY in backend/.env and Config.xcconfig).
# Server-side only — it is never sent to the browser.
APP_API_KEY=replace-me

# Socket.IO connects straight from the browser (JWT auth, no api key).
# Host only, no /api suffix. Also the host whose /img thumbnails are mirrored.
NEXT_PUBLIC_SOCKET_URL=https://esports-app-production.up.railway.app

# Where the site is reachable (used for Google's redirect URI and redirects
# behind Railway's proxy).
PUBLIC_ORIGIN=https://insightesportsapp.com

# ── Team access gate (step 1 of web sign-in) ────────────────────────────────
# A Google OAuth client (Google Cloud Console → APIs & Services → Credentials
# → OAuth client ID, type "Web application") with this authorized redirect URI:
#   https://insightesportsapp.com/app/api/auth/google/callback
# Only verified Google accounts on GOOGLE_ALLOWED_DOMAIN get through to the
# Insight login. Leave GOOGLE_CLIENT_ID empty to turn the gate off (local dev).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_ALLOWED_DOMAIN=insightesportsapp.com
# Signs the gate cookie. Any long random string; falls back to APP_API_KEY.
GATE_SECRET=

# ── Step 2: the Insight account ─────────────────────────────────────────────
# Which app accounts may log in. Unset = any account once the Google gate is
# on (team members' app accounts may be on any email); with the gate OFF it
# defaults to insightesportsapp.com. Set explicitly to force a domain.
# ALLOWED_EMAIL_DOMAIN=insightesportsapp.com

# iPhone visitors are sent here instead of the mobile web (add ?web=1 to a
# URL to opt a browser out for a year, e.g. for testing).
# NEXT_PUBLIC_APP_STORE_URL=https://apps.apple.com/app/id6798031420

# The app's URL prefix (insightesportsapp.com/app). Build-time.
# NEXT_PUBLIC_BASE_PATH=/app

# Set to "true" to mark cookies Secure (always true in production builds).
# COOKIE_SECURE=true

# Avatar upload (EditProfile): the browser sends the image to /api/avatar, which
# uploads it to Supabase Storage (bucket "avatars") with the user's token and
# registers the URL via POST /users/me/avatar — same flow as the iOS app.
# Same values as SUPABASE_URL / SUPABASE_ANON_KEY in Config.xcconfig.
# SUPABASE_URL=https://<project>.supabase.co
# SUPABASE_ANON_KEY=
